# Primary extraction provider: gemini or groq
LLM_PROVIDER=gemini

# Gemini (recommended for the comparison run)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional alternative provider; set LLM_PROVIDER=groq to use it
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional explicit model override; leave blank to use provider-specific model above
LLM_MODEL=
REASONING_EFFORT=low
MAX_COMPLETION_TOKENS=8192
LLM_MAX_API_RETRIES=3
LLM_TIMEOUT_S=90
MAX_RETRIES=0
SELF_CONSISTENCY_SAMPLES=0

# Optional Google Sheets export
# Use the complete service account JSON as a single-line JSON string OR a path to a JSON file.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Spreadsheet ID from its URL. Share the spreadsheet with the service account email.
GOOGLE_SHEETS_SPREADSHEET_ID=
